{
  "name": "websearch-ring",
  "version": "1.1.0",
  "description": "Multi-vendor web search MCP server with keyless-first rotation, automatic failover, bounded TTL cache, and concurrent-request coalescing.",
  "type": "module",
  "bin": {
    "websearch-ring": "./index.js"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "smoke-test.mjs",
    "test",
    "docs"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/unit.test.mjs test/server.test.mjs",
    "test:smoke": "node smoke-test.mjs",
    "test:smoke:offline": "node smoke-test.mjs --offline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TWFU-wcy/websearch-ring.git"
  },
  "homepage": "https://github.com/TWFU-wcy/websearch-ring#readme",
  "bugs": {
    "url": "https://github.com/TWFU-wcy/websearch-ring/issues"
  },
  "author": "TWFU-wcy",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-search",
    "exa",
    "tavily",
    "bing",
    "failover",
    "keyless"
  ],
  "license": "MIT"
}
